flowchart LR
  subgraph Client["Client"]
    EXEC["Executive"] --> UI["Chat UI or CLI"]
  end

  subgraph Agent["Agent service - LangGraph state graph, Cloud Run, stateless"]
    AUTH["verify Google ID token (google-auth), per-user rate limit"]
    LOAD["load_context: user scope, persona, similar trios"]
    PLAN["plan: Gemini call 1, intent and SQL as JSON"]
    RUN["run_queries: guardrails, product scope, cost cap, execute, mask"]
    ANA["analyze: Gemini call 2, answer and optional follow-up queries"]
    DIRECT["direct reply: schema question or greeting"]
    REFUSE["refuse: off-topic or personal data"]
    SAVE["save_report"]
    REQDEL["request_delete: list matching reports"]
    CONFIRM["confirm: graph pauses until the user answers yes or no"]
    GIVEUP["give_up: friendly message after the correction limit"]
    CKPT["Checkpointer: one thread per conversation"]
    LLMC["Gemini client: timeout, retries, fallback model, circuit breaker"]
    SCRUB["PII scrubber: pattern rules and NER model, on rows and on traces"]
    TOOLS["Tool registry: charts, email, web search (future)"]
    BQC["BigQueryClient: dry-run byte cap, typed errors, JSON rows"]
  end
  UI -->|"HTTPS, Google ID token + BigQuery access token, IAP on the Workspace domain"| AUTH
  AUTH --> LOAD --> PLAN
  ANA -->|"answer text + result tables, server-sent events"| UI
  PLAN -->|"analysis"| RUN
  PLAN -->|"schema question, greeting"| DIRECT
  PLAN -->|"other"| REFUSE
  PLAN -->|"save report"| SAVE
  PLAN -->|"delete reports"| REQDEL --> CONFIRM
  RUN -->|"rows"| SCRUB
  SCRUB -->|"masked rows"| ANA
  ANA -.->|"new tools"| TOOLS
  TOOLS -.->|"send or delete: request, then confirm"| CONFIRM
  RUN -->|"error: up to 2 corrections"| PLAN
  RUN -->|"limit reached"| GIVEUP
  ANA -->|"follow-up queries: up to 3 rounds"| RUN
  PLAN -. uses .-> LLMC
  ANA -. uses .-> LLMC
  LLMC -->|"HTTPS, Vertex AI API"| GEM["Gemini - Vertex AI"]
  RUN -->|"retried 3 times if the warehouse is unavailable"| BQC
  BQC -->|"BigQuery API with the user's token, dry run first, job labels"| BQ[("BigQuery: PII-free views + row-level security per Google group")]
  CONFIRM -.-> CKPT

  subgraph Data["State"]
    PG[("Cloud SQL Postgres + pgvector: reports, pending deletions, checkpoints, preferences, knowledge index")]
    GCS[("Cloud Storage: Golden bucket, versioned trios")]
    CFG[("Config store: persona text, metric definitions, user scopes, prices")]
  end
  AUTH -->|"rate-limit counter"| PG
  LOAD -->|"top 3 similar trios"| PG
  SAVE --> PG
  CONFIRM -->|"confirmed: soft delete"| PG
  CKPT --> PG
  LOAD -->|"read at every turn"| CFG
  GCS -->|"ingestion job: validate, embed, index"| PG

  subgraph Learn["Learning loop - offline"]
    FB["Feedback and traces"] --> CAND["Candidate trios"]
    CAND --> EVAL["Automatic checks: SQL runs, numbers match, no PII"]
    EVAL --> REV["Analyst approval"]
    REV --> GCS
  end
  EVAL -->|"offline service account, PII-free views only"| BQ

  Agent -->|"OTLP, scrubbed"| OBS["OpenTelemetry traces, metrics, logs"]
  OBS --> LF["Langfuse: LLM traces, tokens, cost, evals"]
  OBS --> MON["Cloud Monitoring: alerts, dashboards"]
  OBS --> FB

  ADMIN["Admin page: persona text, metric definitions"] --> CFG
  SM["Secret Manager"] -.-> Agent
