GEMINI_API_KEY=
# Models are read only from the environment (no defaults). Lite models have the most spare capacity.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GCP_PROJECT_ID=
# BigQuery credentials file; optional if `gcloud auth application-default login` wrote the default one
GOOGLE_APPLICATION_CREDENTIALS=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES_BILLED=1000000000
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analyst
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=20
# 0 = no retry on the same model; the fallback model covers a failure.
LLM_MAX_RETRIES=0
# Set to 1 to also record each prompt, raw model answer and the (masked) rows of each query in the trace.
TRACE_VERBOSE=0
